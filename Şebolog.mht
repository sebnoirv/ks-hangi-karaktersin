@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; background: rgb(246, 243, 248); color: rgb(32, 29, 39); font-family: Arial, sans-serif; }

.wrap { max-width: 1080px; margin: auto; padding: 0px 20px; }

header { background: rgb(255, 255, 255); border-bottom: 1px solid rgb(232, 228, 235); }

.nav { height: 74px; display: flex; align-items: center; justify-content: space-between; }

.logo { font-size: 30px; font-weight: 900; letter-spacing: -1.5px; }

.logo small { display: block; font-size: 10px; letter-spacing: 2px; color: rgb(138, 132, 145); margin-top: -2px; }

.hero { padding: 38px 0px 20px; }

.hero-box { background: linear-gradient(135deg, rgb(34, 29, 43), rgb(91, 75, 105)); border-radius: 26px; padding: 42px; color: rgb(255, 255, 255); }

.eyebrow { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; opacity: 0.75; }

.hero h1 { font-size: 43px; line-height: 1.03; margin: 12px 0px; max-width: 700px; }

.hero p { font-size: 17px; color: rgb(221, 215, 225); max-width: 650px; line-height: 1.5; }

section { padding: 12px 0px 22px; }

h2 { font-size: 25px; margin: 12px 0px 17px; }

.feature { background: rgb(255, 255, 255); border: 1px solid rgb(233, 229, 236); border-radius: 22px; padding: 25px; display: flex; gap: 25px; align-items: center; justify-content: space-between; box-shadow: rgba(0, 0, 0, 0.043) 0px 8px 28px; }

.tag { display: inline-block; padding: 7px 10px; border-radius: 99px; background: rgb(238, 232, 255); color: rgb(96, 74, 167); font-size: 11px; font-weight: 800; }

.feature h3 { font-size: 28px; margin: 11px 0px 8px; }

.feature p { color: rgb(111, 105, 116); line-height: 1.5; margin: 0px; }

.btn { display: inline-block; background: rgb(36, 31, 45); color: rgb(255, 255, 255); text-decoration: none; font-weight: 800; padding: 14px 19px; border-radius: 13px; white-space: nowrap; }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }

.tile { background: rgb(255, 255, 255); border: 1px solid rgb(233, 229, 236); border-radius: 18px; padding: 21px; min-height: 125px; }

.tile h3 { margin: 0px 0px 8px; }

.tile p { margin: 0px; color: rgb(119, 119, 119); line-height: 1.45; font-size: 14px; }

.soon { background: rgb(255, 255, 255); border: 1px dashed rgb(207, 199, 214); border-radius: 20px; padding: 25px; color: rgb(111, 105, 116); }

footer { text-align: center; padding: 30px; color: rgb(138, 132, 144); font-size: 12px; }

@media (max-width: 700px) {
  .hero h1 { font-size: 34px; }
  .hero-box { padding: 30px 24px; }
  .feature { display: block; }
  .btn { margin-top: 20px; }
  .grid { grid-template-columns: 1fr; }
  .nav { height: 66px; }
}
